# Place limit_req_zone in nginx's http {} block (not inside server {}).
# limit_req_zone $binary_remote_addr zone=courrier_api:10m rate=10r/s;

server {
    listen 443 ssl http2;
    server_name courrier.example.com;

    ssl_certificate /etc/letsencrypt/live/courrier.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/courrier.example.com/privkey.pem;

    auth_basic "Courrier";
    auth_basic_user_file /etc/nginx/secrets/courrier.htpasswd;

    client_max_body_size 32m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /api/ {
        limit_req zone=courrier_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/snippets/courrier-proxy-headers.conf;
    }

    location /auth/ {
        limit_req zone=courrier_api burst=10 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/snippets/courrier-proxy-headers.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/snippets/courrier-proxy-headers.conf;
    }
}
